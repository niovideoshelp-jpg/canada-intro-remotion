{
  "name": "canada-intro",
  "version": "1.0.0",
  "private": true,
  "description": "Canada – Intro (NIO500). Documentario animado estilo Vox em Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts CanadaIntro",
    "render:raw": "remotion render src/index.ts CanadaIntro out/canada-intro-raw.mp4",
    "post": "node scripts/crt-post.mjs out/canada-intro-raw.mp4 out/canada-intro.mp4",
    "render": "npm run render:raw && npm run post"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/gsap": "4.0.541",
    "@remotion/media": "4.0.541",
    "d3-geo": "^3.1.1",
    "gsap": "3.15.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "polygon-clipping": "^0.15.7",
    "typescript": "^5.9.3"
  }
}
